// Sesión PLATAFORMA (rama a/…, app altardiario-plataforma). Ver docs/CAPACIDADES.md.
// Plantilla: scripts/nueva-sesion.sh la copia a <carpeta-de-la-sesion>/opencode.jsonc.
// Sintaxis V2: en `policies` gana la última regla que coincide (negar en bloque, luego permitir).
{
  "policies": [
    // ── Skills: reglas de Firestore, emulador, seguridad, CI y observabilidad ──
    { "action": "integration.use", "resource": "skill:*", "effect": "deny" },
    { "action": "integration.use", "resource": "skill:firestore-rules", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:firebase-firestore", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:firebase-emulator", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:observability", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:architecture", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:testing", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:security-reviewer", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:secure-code-guardian", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:devops-engineer", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:monitoring-expert", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:debugging-wizard", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:test-master", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:mcp-developer", "effect": "allow" },

    // ── MCP: documentación, lectura web y memoria. Sin roadmap de escritura ──
    { "action": "integration.use", "resource": "mcp:*", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:context7", "effect": "allow" },
    { "action": "integration.use", "resource": "mcp:fetch", "effect": "allow" },
    { "action": "integration.use", "resource": "mcp:knowledge-graph-memory", "effect": "allow" },

    // ── Plugins: ninguno ──
    { "action": "integration.use", "resource": "plugin:superpowers", "effect": "deny" }
  ]
}
